# Generated by ctl.sh. The DSN points at the Oracle container's address on the
# container network. No credential appears here: the password comes from
# MIGR8_PASSWORD at run time.
[database]
adapter = "oracle"
dsn = "@ORACLE_DSN@"
user = "@ORACLE_USER@"
target_schema = "@ORACLE_USER@"

[oracle]
ddl_lock_timeout_seconds = 30

[lock]
provider = "dbms_lock"
package = "SYS.DBMS_LOCK"
id = 4711
timeout_seconds = 60
